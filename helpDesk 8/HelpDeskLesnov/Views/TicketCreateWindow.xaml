<Window x:Class="HelpDeskLesnov.Views.TicketCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Новая заявка"
        Height="540"
        Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Новая заявка"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2"
                   Text="Категория"
                   FontSize="14"/>

        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="3"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="0">

            <ComboBoxItem Content="Выберите категорию"
                          IsEnabled="False"/>

            <ComboBoxItem Content="Оборудование"/>

            <ComboBoxItem Content="Программное обеспечение"/>

            <ComboBoxItem Content="Сеть"/>

            <ComboBoxItem Content="Учётная запись"/>

            <ComboBoxItem Content="Периферия"/>

            <ComboBoxItem Content="Другое"/>

        </ComboBox>

        <TextBlock Grid.Row="5"
                   Text="Описание проблемы"
                   FontSize="14"/>

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="6"
                 Height="120"
                 FontSize="14"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="8"
                   Text="Приоритет"
                   FontSize="14"/>

        <ComboBox x:Name="PriorityComboBox"
                  Grid.Row="9"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="1">

            <ComboBoxItem Content="Низкий"/>

            <ComboBoxItem Content="Средний"/>

            <ComboBoxItem Content="Высокий"/>

        </ComboBox>

        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Width="140"
                    Height="48"
                    Margin="10"
                    Click="SaveButton_Click"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Width="140"
                    Height="48"
                    Margin="10"
                    Click="CancelButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
